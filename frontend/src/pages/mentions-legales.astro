---
import AppLayout from "../layouts/AppLayout.astro";

// Valeurs identité/légales injectées au build (comme PUBLIC_API_URL) plutôt
// que codées en dur, pour que ce gabarit reste réutilisable tel quel sur un
// autre déploiement sans toucher au code.
const domain = import.meta.env.PUBLIC_DOMAIN ?? "derniere-chance.ecosolva.org";
const editorName = import.meta.env.PUBLIC_LEGAL_EDITOR_NAME ?? "Gilles Maury";
const editorStatus =
  import.meta.env.PUBLIC_LEGAL_EDITOR_STATUS ??
  "indépendant (architecte solutions & développeur freelance)";
const editorCity = import.meta.env.PUBLIC_LEGAL_EDITOR_CITY ?? "Bruxelles, Belgique";
const businessNumber = import.meta.env.PUBLIC_LEGAL_BUSINESS_NUMBER ?? "BE0670.778.061";
const contactEmail = import.meta.env.PUBLIC_LEGAL_CONTACT_EMAIL ?? "gilmry@gmail.com";
const githubRepo = import.meta.env.PUBLIC_GITHUB_REPO ?? "gilmry/derniere-chance";
---

<AppLayout title="Mentions légales">
  <div class="screen">
    <h1>Mentions légales</h1>

    <div class="card">
      <h2>Éditeur du site</h2>
      <p>
        DernièreChance (<code>{domain}</code>) est édité par {editorName}, {editorStatus}, basé à {editorCity}.
      </p>
      <p>
        Numéro d'entreprise (BCE/TVA) : {businessNumber}<br />
        Contact : <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
    </div>

    <div class="card">
      <h2>Directeur de publication</h2>
      <p>{editorName}.</p>
    </div>

    <div class="card">
      <h2>Hébergement</h2>
      <p>
        DernièreChance est auto-hébergé : l'application (backend, frontend,
        base de données PostgreSQL) tourne sur un serveur administré
        directement par l'éditeur, sans sous-traitant d'hébergement tiers.
        Le trafic est chiffré via Traefik et Let's Encrypt.
      </p>
    </div>

    <div class="card">
      <h2>Propriété intellectuelle</h2>
      <p>
        Le code source de DernièreChance est publié sous licence libre MIT
        et disponible sur
        <a href={`https://github.com/${githubRepo}`} target="_blank" rel="noopener">
          github.com/{githubRepo}
        </a>.
      </p>
    </div>

    <div class="card">
      <h2>Données personnelles</h2>
      <p>
        Les seules données personnelles traitées sont celles nécessaires au
        fonctionnement du service : l'email et le mot de passe (chiffré via
        bcrypt côté serveur) des comptes marchand et consommateur, ainsi que
        le nom, l'adresse et la catégorie renseignés par un marchand à son
        inscription.
      </p>
      <p>
        Un marchand peut partager sa position (via son navigateur) à
        l'inscription pour être localisé sur la carte - c'est facultatif, un
        refus n'empêche pas d'utiliser le service. La position du
        consommateur, elle, n'est jamais enregistrée : elle n'est utilisée
        que le temps d'une requête pour calculer une distance, puis
        aussitôt oubliée.
      </p>
      <p>
        Aucune donnée n'est transmise à un tiers, aucun traceur publicitaire
        ou de mesure d'audience n'est utilisé.
      </p>
      <p>
        Le jeton de session (JWT) est stocké dans le stockage local du
        navigateur (<code>localStorage</code>) et expire automatiquement
        après 24h pour un compte marchand, 30 jours pour un compte
        consommateur.
      </p>
      <p>
        Pour toute question relative à vos données, contactez
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
    </div>
  </div>
</AppLayout>

<style>
  .screen {
    padding: 24px 20px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: 22px;
  }

  h2 {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
  }

  .card p {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
  }

  code {
    font-family: monospace;
    background: var(--color-chip);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
