---
import AppLayout from "../../layouts/AppLayout.astro";
import MerchantProfile from "../../components/MerchantProfile.svelte";
import { merchants } from "../../lib/mock";

export function getStaticPaths() {
  return merchants.map((merchant) => ({
    params: { id: merchant.id },
    props: { merchant },
  }));
}

const { merchant } = Astro.props;
---

<AppLayout title={merchant.name}>
  <MerchantProfile merchant={merchant} client:load />
</AppLayout>
