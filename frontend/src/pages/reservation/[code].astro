---
import AppLayout from "../../layouts/AppLayout.astro";
import ReservationConfirm from "../../components/ReservationConfirm.svelte";
import { offers, getMerchant, reservationCodeFor } from "../../lib/mock";

export function getStaticPaths() {
  return offers.map((offer) => ({
    params: { code: reservationCodeFor(offer) },
    props: { offer, merchant: getMerchant(offer.merchantId), code: reservationCodeFor(offer) },
  }));
}

const { offer, merchant, code } = Astro.props;
---

<AppLayout title="Panier réservé">
  <ReservationConfirm offer={offer} merchant={merchant} code={code} client:load />
</AppLayout>
