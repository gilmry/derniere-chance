# Copy to .env and adjust before running `docker compose up`

# --- Postgres ---
POSTGRES_DB=derniere_chance
POSTGRES_USER=derniere_chance
POSTGRES_PASSWORD=change-me

# --- Backend ---
DATABASE_URL=postgresql://derniere_chance:change-me@postgres:5432/derniere_chance
JWT_SECRET=change-me-too-please-use-a-long-random-string
RUST_LOG=info

# --- Photo storage (MinIO/S3) ---
S3_BUCKET=photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too

# --- Backoffice admin (compte unique, créé au premier démarrage si absent) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# --- Notifications (webhook n8n -> email, vide = désactivé) ---
WEBHOOK_NOTIFY_URL=

# --- Base des liens insérés dans les emails (fiche offre, profil) ---
APP_BASE_URL=https://derniere-chance.ecosolva.org

# --- Emails de notification aux abonnés : relais SMTP ---
# Chemin retenu. Prend le pas sur Mailjet quand les deux sont configurés, ce
# qui permet de basculer de l'un à l'autre en vidant trois variables, sans
# redéployer. Tout vide = aucun envoi, le backend journalise seulement et le
# dit au démarrage.
# SMTP_PROTOCOL n'est consulté que s'il vaut explicitement STARTTLS ou SMTPS :
# les fournisseurs étiquettent « TLS/SSL » les deux modes (Proton le fait sur
# le 587, qui est pourtant du STARTTLS), donc c'est le port qui tranche sinon.
# Le clair n'est jamais utilisé.
SMTP_SERVEUR=smtp.protonmail.ch
SMTP_PORT=587
SMTP_PROTOCOL=TLS/SSL
SMTP_USER=
SMTP_TOKEN=
# Facultatif : expédier depuis une autre adresse que SMTP_USER, si le relais
# l'autorise. Par défaut l'expéditeur est SMTP_USER.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DernièreChance

# --- Emails de notification aux abonnés (Mailjet, chemin de secours) ---
# Mailjet SAS, infrastructure européenne : pas de transfert hors UE (voir
# docs/rgpd/registre-traitements.md). Les clés viennent de Mailjet >
# Paramètres du compte > Gestion des clés API. L'adresse d'expédition doit
# être validée chez Mailjet, sinon l'API refuse chaque envoi.
# Laisser vide désactive l'envoi : le backend journalise seulement.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=DernièreChance

# --- Frontend (dev only - prod is reached via Traefik on 80/443) ---
FRONTEND_PORT=4322
PUBLIC_API_URL=http://localhost:8080

# --- Mentions légales (build-time placeholders, voir docker-publish.yml pour la prod) ---
# Toute valeur contenant une espace doit être entre guillemets : dotenvy
# s'arrête à la première ligne qu'il ne sait pas lire et ignore, sans bruit,
# tout ce qui suit dans le fichier.
PUBLIC_LEGAL_EDITOR_NAME="Gilles Maury"
PUBLIC_LEGAL_EDITOR_STATUS="indépendant (architecte solutions & développeur freelance)"
PUBLIC_LEGAL_EDITOR_CITY="Bruxelles, Belgique"
PUBLIC_LEGAL_BUSINESS_NUMBER=BE0670.778.061
PUBLIC_LEGAL_CONTACT_EMAIL=gilmry@gmail.com
PUBLIC_GITHUB_REPO=gilmry/derniere-chance

# --- Prod images (pulled from GHCR by CI, see docker-publish.yml) ---
# Ces valeurs servent aux usages manuels. Le déploiement automatique les
# ignore : deploy.sh épingle les deux images au tag `sha-<court>` du commit
# visé et attend qu'elles soient TOUTES publiées avant de déployer, pour ne
# jamais mélanger un frontend et un backend de commits différents.
BACKEND_IMAGE=ghcr.io/gilmry/derniere-chance/backend:latest
FRONTEND_IMAGE=ghcr.io/gilmry/derniere-chance/frontend:latest

# --- Traefik / TLS (production) ---
# Point both DNS A records at the shared VPS host before `docker compose up`.
# The shared Traefik stack (fronting Elevia too) must already be running with
# the `ecosolva-web` external network created.
DOMAIN=derniere-chance.ecosolva.org
API_DOMAIN=api.derniere-chance.ecosolva.org
